;;; gen-fixtures.el --- Regenerate expected outputs for test-fixtures/org  -*- lexical-binding: t; -*-

;; Usage, from the repository root:
;;
;;   emacs --batch -l scripts/gen-fixtures.el
;;
;; For every test-fixtures/org/parser/NAME.org this writes NAME.tree: the element structure Emacs
;; `org-element-parse-buffer' builds, reduced to element types plus a few properties per element.
;; `ParserFixtureTest' in org-core renders our tree in the same format and compares. CI does not need Emacs: the
;; .tree files are committed.

;;; Code:

(require 'org)
(require 'org-element)

(defconst gen-fixtures-root
  (expand-file-name ".." (file-name-directory (or load-file-name buffer-file-name))))

(defun gen-fixtures--quote (value)
  "Quote VALUE (a string or nil) the way the Kotlin side does."
  (prin1-to-string (substring-no-properties (or value ""))))

(defun gen-fixtures--block-type (type)
  (pcase type
    ('src-block "src") ('example-block "example") ('export-block "export") ('comment-block "comment")
    ('verse-block "verse") ('quote-block "quote") ('center-block "center") (_ nil)))

(defun gen-fixtures--props (el)
  "Properties of EL that the fixtures compare."
  (pcase (org-element-type el)
    ('headline
     (concat
      (format " level=%d" (org-element-property :level el))
      (let ((kw (org-element-property :todo-keyword el)))
        (if kw (format " todo=%s/%s" kw (org-element-property :todo-type el)) ""))
      (let ((p (org-element-property :priority el))) (if p (format " priority=%c" p) ""))
      (let ((tags (org-element-property :tags el)))
        (if tags (format " tags=%s" (mapconcat #'substring-no-properties tags ":")) ""))
      (format " title=%s" (gen-fixtures--quote (org-element-property :raw-value el)))))
    ('keyword
     (format " key=%s value=%s" (org-element-property :key el)
             (gen-fixtures--quote (org-element-property :value el))))
    ('node-property
     (format " key=%s value=%s" (org-element-property :key el)
             (gen-fixtures--quote (org-element-property :value el))))
    ('drawer (format " name=%s" (org-element-property :drawer-name el)))
    ('src-block
     (let ((lang (org-element-property :language el))) (if lang (format " language=%s" lang) "")))
    ('special-block (format " type=%s" (org-element-property :type el)))
    ('plain-list (format " type=%s" (org-element-property :type el)))
    ('item (let ((cb (org-element-property :checkbox el))) (if cb (format " checkbox=%s" cb) "")))
    ('table (format " rows=%d" (length (org-element-contents el))))
    (_ "")))

(defun gen-fixtures--dump (el depth)
  "Insert EL and its child elements, indented by DEPTH."
  (insert (make-string (* 2 depth) ?\s) (symbol-name (org-element-type el)) (gen-fixtures--props el) "\n")
  (unless (eq (org-element-type el) 'table)
    (dolist (child (org-element-contents el))
      (when (memq (org-element-type child) org-element-all-elements)
        (gen-fixtures--dump child (1+ depth))))))

(defun gen-fixtures--parser (file)
  "Write the reduced org-element tree of FILE next to it."
  (let ((tree (with-temp-buffer
                (insert-file-contents file)
                (org-mode)
                (org-element-parse-buffer)))
        (out (concat (file-name-sans-extension file) ".tree")))
    (with-temp-file out
      (setq buffer-file-coding-system 'utf-8-unix)
      (insert (format "# Generated by scripts/gen-fixtures.el with Org %s from %s. Do not edit.\n"
                      (org-version) (file-name-nondirectory file)))
      (gen-fixtures--dump tree 0))
    (message "Wrote %s" (file-relative-name out gen-fixtures-root))))

(let ((org-todo-keywords '((sequence "TODO" "DONE")))
      (org-list-allow-alphabetical nil)
      (tab-width 8))
  (dolist (file (directory-files (expand-file-name "test-fixtures/org/parser" gen-fixtures-root) t "\\.org\\'"))
    (gen-fixtures--parser file)))

;;; gen-fixtures.el ends here
